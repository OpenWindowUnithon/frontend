{
	"name": "frontend",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc -b",
		"arch:lint": "steiger ./src",
		"check": "bun run lint && bun run typecheck && bun run arch:lint",
		"new:slice": "bun scripts/new-slice.ts",
		"deploy": "bun run build && wrangler pages deploy dist",
		"deploy:preview": "tsc -b && vite build --mode preview && wrangler pages deploy dist --branch=preview",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@seed-design/vite-plugin": "^2.1.0",
		"@tanstack/react-query-devtools": "^5.102.1",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/router-plugin": "^1.168.35",
		"@types/bun": "latest",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"lefthook": "^2.1.10",
		"shadcn": "^4.19.0",
		"steiger": "^0.6.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"wrangler": "^4.125.0"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@hookform/resolvers": "^5.9.1",
		"@karrotmarket/react-monochrome-icon": "^1.25.0",
		"@karrotmarket/react-multicolor-icon": "^1.27.0",
		"@mediapipe/tasks-vision": "^1.0.1",
		"@seed-design/css": "^2.5.0",
		"@seed-design/react": "^2.3.0",
		"@seed-design/tailwind4-theme": "^2.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.102.1",
		"@tanstack/react-router": "^1.170.32",
		"axios": "^1.19.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.23",
		"es-toolkit": "^1.51.0",
		"livekit-client": "^2.22.0",
		"lucide-react": "^1.33.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.86.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"usehooks-ts": "^3.1.1",
		"zod": "^4.4.3",
		"zustand": "^5.0.15"
	},
	"trustedDependencies": [
		"@swc/core"
	]
}
