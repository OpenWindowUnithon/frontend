# Leave empty for local dev — vite.config.ts's /api proxy forwards there,
# sidestepping the backend's still-broken CORS preflight handling. Set to a
# real URL once CORS is fixed backend-side, for deployed use.
VITE_API_BASE_URL=
# "production" | "preview" -- defaults to "production", see .env.preview / deploy:preview.
VITE_APP_ENV=
