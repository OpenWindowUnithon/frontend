VITE_API_BASE_URL=http://localhost:8787

# Set to true to serve entities/todo's API from an in-memory mock instead of
# a real backend — useful before the backend exists yet, or as a fallback
# if it goes down right before a demo. See src/entities/todo/api/todo-api.ts.
VITE_USE_MOCK=false

# LiveKit Cloud project WebSocket URL (public, safe to expose to the client).
# The API key/secret used to mint room tokens live server-side only — see
# .dev.vars.example / functions/api/livekit-token.ts.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
