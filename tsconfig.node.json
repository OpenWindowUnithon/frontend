{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"types": ["node", "bun", "@cloudflare/workers-types"]
	},
	"include": ["vite.config.ts", "scripts/**/*.ts", "steiger.config.ts", "functions/**/*.ts"]
}
