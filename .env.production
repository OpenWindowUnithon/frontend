# Committed on purpose (not a secret, just the deployed backend URL).
# Cloudflare Pages dashboard env vars weren't propagating into the build
# container for this project (confirmed via build logs across both
# API-triggered and real git-push-triggered deployments) — this sidesteps
# that entirely since Vite loads .env.production itself during `vite build`.
VITE_API_BASE_URL=https://naru-backend.perasite.dev
